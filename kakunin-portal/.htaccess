# kakunin/ フォルダーの .htaccess（このまま 置く）
# ・一覧表示を しない　・検索に 出さない　・lib.php を 直接 開かせない
Options -Indexes
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Referrer-Policy "no-referrer"
</IfModule>
<Files "lib.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
