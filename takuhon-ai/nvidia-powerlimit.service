# /etc/systemd/system/nvidia-powerlimit.service
#
# GPU の電力の上限を、起動のたびに下げる。
#
# なぜ要るか
#   nvidia-smi -pl で下げても、**再起動すると 350W に戻る**。
#   停電で落ちる → 立ち上げ直す → 上限は元どおり、では意味がない。
#   3090 は学習中、一瞬だけ上限をはるかに超えて電気を引く（数ミリ秒）。
#   電源ユニットの保護が働くと、記録を残す間もなく、ぷつりと落ちる。
#
# 入れ方
#   sudo cp nvidia-powerlimit.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nvidia-powerlimit
#   nvidia-smi -q -d POWER | grep "Power Limit"      ← 300W になっていれば入った
#
# 変えたいとき
#   下の 300 を書き換えて、daemon-reload → restart。
#   3090 なら 300W で性能は数 % しか落ちない。まだ落ちるなら 275 → 250 と下げる。
[Unit]
Description=GPU の電力上限を下げる（学習中の突然死よけ）
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
# -pm 1 … 待機中も設定を保つ。-pl … 上限（W）
ExecStart=/usr/bin/nvidia-smi -pm 1
ExecStart=/usr/bin/nvidia-smi -pl 300

[Install]
WantedBy=multi-user.target
