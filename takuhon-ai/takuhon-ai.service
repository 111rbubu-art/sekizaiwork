# /etc/systemd/system/takuhon-ai.service
# sudo systemctl daemon-reload && sudo systemctl enable --now takuhon-ai
[Unit]
Description=拓本クリーン化サーバー
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/takuhon-ai
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/takuhon-ai/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8077
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
